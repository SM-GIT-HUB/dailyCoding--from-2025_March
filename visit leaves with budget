class Solution {
  public:
    int getCount(Node* root, int k) {
        // code here
        int count = 0;
        
        queue<Node*> q;
        
        int lvl = 1;
        q.push(root);
        
        while (!q.empty())
        {
            int size = int(q.size());
            
            while (size--)
            {
                Node* curr = q.front();
                q.pop();
                
                if (k < lvl) {
                    break;
                }
                
                if (!curr->left && !curr->right)
                {
                    ++count;
                    k -= lvl;
                }
                
                if (curr->left) {
                    q.push(curr->left);
                }
                
                if (curr->right) {
                    q.push(curr->right);
                }
            }
            
            ++lvl;
        }
        
        return count;
    }
};
