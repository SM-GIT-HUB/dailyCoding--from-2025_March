class Solution {
  public:
    int minSubarraySum(vector<int>& arr) {
        // code here
        int sum = 0;
        int ans = INT_MAX;
        
        for (int x : arr)
        {
            sum += x;
            ans = min(sum, ans);
            
            if (sum > 0) {
                sum = 0;
            }
        }
        
        return ans;
    }
};
