class Solution {
public:
    int minimizeSum(vector<int>& arr) {
        int mx1 = 0, mx2 = 0, mx3 = 0;
        int mn1 = 1e6, mn2 = 1e6, mn3 = 1e6;

        for (int x : arr)
        {
            if (x <= mn1)
            {
                mn3 = mn2;
                mn2 = mn1;
                mn1 = x;
            }
            else if (x <= mn2)
            {
                mn3 = mn2;
                mn2 = x;
            }
            else if (x < mn3) {
                mn3 = x;
            }
            
            if (x >= mx1)
            {
                mx3 = mx2;
                mx2 = mx1;
                mx1 = x;
            }
            else if (x >= mx2)
            {
                mx3 = mx2;
                mx2 = x;
            }
            else if (x > mx3) {
                mx3 = x;
            }
        }

        int ans = min(mx1 - mn3, mx2 - mn2);
        return min(mx3 - mn1, ans);
    }
};
