class Solution {
  public:
    using int64 = int64_t;
    
    int mod = 1e9 + 7;
    
    int64 power(int64 n, int64 m)
    {
        int64 mul = 1;
        
        while (m)
        {
            if (m & 1) {
                mul = (mul * n) % mod;
            }
            
            m = (m >> 1);
            n = (n * n) % mod;
        }
        
        return mul;
    }
  
    int subsequenceSum(string &s) {
        // code here
        int n = int(s.size());
        int64 p = power(2, n - 1);
        
        int64 sum = 0;
        
        for (char ch : s)
        {
            int d = ch - '0';
            
            sum = (sum + p * d % mod) % mod;
        }
        
        return sum;
    }
};
