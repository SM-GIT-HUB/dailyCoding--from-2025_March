class Solution {
  public:
    int minSubsets(vector<int>& arr) {
        // code here
        sort(arr.begin(), arr.end());
        
        int count = 1;
        int y = arr[0] - 1;
        
        for (int x : arr)
        {
            if (y + 1 != x) {
                ++count;
            }
            
            y = x;
        }
        
        return count;
    }
};
