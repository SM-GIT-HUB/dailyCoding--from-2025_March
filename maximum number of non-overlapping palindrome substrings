class Solution {
public:
    int isPalin(int i, int j, string &str)
    {
        while (i <= j)
        {
            if (str[i++] != str[j--]) {
                return 0;
            }
        }

        return 1;
    }

    int maxPalindromes(string s, int k) {
        int n = int(s.size());

        int count = 0;

        for (int i = 0; i + k - 1 < n; i++)
        {
            if (isPalin(i, i + k - 1, s))
            {
                ++count;
                i = i + k - 1;
            }
            else if (isPalin(i, i + k, s))
            {
                ++count;
                i = i + k;
            }
        }

        return count;
    }
};
