bool searchMatrix(vector<vector<int> >& mat, int target) {
    int m = int(mat.size());
    int n = int(mat[0].size());

    int start = 0, end = m * n - 1;

    while (start <= end)
    {
        int mid = (start + end) / 2;

        int x = mid / n;
        int y = mid % n;

        if (mat[x][y] == target) {
            return 1;
        }
        else if (mat[x][y] < target) {
            start = mid + 1;
        }
        else
            end = mid - 1;
    }

    return 0;
}
