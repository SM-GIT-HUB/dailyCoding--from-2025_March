class Solution {
  public:
    int firstElementKTime(vector<int>& arr, int k) {
        // code here
        unordered_map<int, int> mapp;
        
        for (int x : arr)
        {
            if (++mapp[x] == k) {
                return x;
            }
        }
        
        return -1;
    }
};
