#include <bits/stdc++.h>

int countCubeSumPairs(int n) {
    // Write your code here.
    int count = 0;
    int ma = cbrt(n);

    for (int a = 1; a <= ma; a++)
    {
        int pw = a * a * a;

        int b = cbrt(n - pw);

        if (pw + b * b * b == n) {
            ++count;
        }
    }

    return count;
}
