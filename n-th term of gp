
int mod = 1e9 + 7;

long long power(long long n, long long m)
{
    long long p = 1;

    while (m)
    {
        if (m & 1) {
            p = (p * n) % mod;
        }

        n = (n * n) % mod;
        m = (m >> 1);
    }

    return p;
}

int nthTermOfGP(int N, long long A, int R) {
    // Write your code here.
    long long ans = (A * power(R, N - 1)) % mod;
    return ans;
}

