/************************************************************

    Following is the TreeNode class structure

    template <typename T>
    class TreeNode {
       public:
        T data;
        TreeNode<T> *left;
        TreeNode<T> *right;

        TreeNode(T data) {
            this->data = data;
            left = NULL;
            right = NULL;
        }
    };

************************************************************/

using Node = TreeNode<int>;

void dfs(Node* root, vector<int>& ans)
{
    if (!root) {
        return;
    }

    ans.push_back(root->data);

    dfs(root->left, ans);
    dfs(root->right, ans);
}

vector<int> preOrder(TreeNode<int>* root){
    // Write your code here.
    vector<int> ans;
    dfs(root, ans);

    return ans;
}
