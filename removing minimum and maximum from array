class Solution {
public:
    int minimumDeletions(vector<int>& arr) {
        int n = int(arr.size());

        if (n == 1) {
            return 1;
        }

        int i = 0;
        int j = 0;

        for (int idx = 0; idx < n; idx++)
        {
            if (arr[idx] > arr[i]) {
                i = idx;
            }

            if (arr[idx] < arr[j]) {
                j = idx;
            }
        }

        if (i > j) {
            swap(i, j);
        }

        int one = i + 1 + n - j;
        int two = j + 1;
        int three = n - i;
        
        return min({one, two, three});
    }
};
