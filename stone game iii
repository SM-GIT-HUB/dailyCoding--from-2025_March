int dp[50005];

class Solution {
public:
    string stoneGameIII(vector<int>& arr) {
        int n = int(arr.size());

        for (int i = n; i < n + 3; i++)
        {
            dp[i] = 0;
        }

        for (int i = n - 1; i >= 0; i--)
        {
            int s = arr[i];
            dp[i] = INT_MIN;

            dp[i] = max(dp[i], s - dp[i + 1]);

            if (i + 1 < n)
            {
                s += arr[i + 1];
                dp[i] = max(dp[i], s - dp[i + 2]);
            }

            if (i + 2 < n)
            {
                s += arr[i + 2];
                dp[i] = max(dp[i], s - dp[i + 3]);
            }
        }

        int apu = dp[0];

        if (apu > 0) {
            return "Alice";
        }
        else if (apu < 0) {
            return "Bob";
        }
        
        return "Tie";
    }
};
