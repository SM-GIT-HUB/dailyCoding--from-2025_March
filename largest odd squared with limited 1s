class Solution {
  public:
    vector<int> largestSquare(vector<vector<int> >& mat, vector<vector<int> >& queries, int k) {
        // code here
        int m = int(mat.size());
        int n = int(mat[0].size());
        
        for (int j = 1; j < n; j++)
        {
            mat[0][j] += mat[0][j - 1];
        }
        
        for (int i = 1; i < m; i++)
        {
            mat[i][0] += mat[i - 1][0];
        }
        
        for (int i = 1; i < m; i++)
        {
            for (int j = 1; j < n; j++)
            {
                mat[i][j] += mat[i - 1][j] + mat[i][j - 1] - mat[i - 1][j - 1];
            }
        }
        
        vector<int> ans;
        
        auto isPos = [&k, &mat](int x, int y, int l) {
            int total = mat[x + l][y + l];
            
            if (x - 1 >= 0) {
                total -= mat[x - 1][y + l];
            }
            
            if (y - 1 >= 0) {
                total -= mat[x + l][y - 1];
            }
            
            if (x - 1 >= 0 && y - 1 >= 0) {
                total += mat[x - 1][y - 1];
            }
            
            return (total <= k);
        };
        
        for (auto &q : queries)
        {
            int x = q[0], y = q[1];
            
            int l = 0;
            
            while (x >= 0 && y >= 0 && x + l < m && y + l < n && isPos(x, y, l))
            {
                l += 2;
                x--;
                y--;
            }
            
            l -= 2;
            
            ans.push_back(max(l + 1, -1));
        }
        
        return ans;
    }
};
