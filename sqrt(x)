class Solution {
public:
    int mySqrt(int x) {
        int ans = 0;

        int64_t mid = 0;
        int start = 0, end = x;

        while (start <= end)
        {
            mid = (start + end) >> 1;

            if (mid * mid <= x)
            {
                ans = mid;
                start = mid + 1;
            }
            else
                end = mid - 1;
        }

        return ans;
    }
};
