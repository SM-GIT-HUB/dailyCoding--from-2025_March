#include <bits/stdc++.h>

int specialSum(vector<int>& arr, int n){
    // Write your code here.
    int sum = accumulate(arr.begin(), arr.end(), 0);

    while (sum / 10)
    {
        int ns = 0;

        for (char ch : to_string(sum))
        {
            ns += (ch - '0');
        }

        sum = ns;
    }

    return sum;
}
