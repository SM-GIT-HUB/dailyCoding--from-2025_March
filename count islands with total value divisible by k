class Solution {
public:
    int dirs[4][2] = {{-1, 0}, {0, 1}, {1, 0}, {0, -1}};

    int countIslands(vector<vector<int> >& grid, int k) {
        int m = int(grid.size());
        int n = int(grid[0].size());

        int count = 0;
        queue<pair<int, int> > q;

        for (int i = 0; i < m; i++)
        {
            for (int j = 0; j < n; j++)
            {
                if (!grid[i][j]) {
                    continue;
                }

                int rem = grid[i][j] % k;
                grid[i][j] = 0;

                q.push({i, j});

                while (!q.empty())
                {
                    auto [x, y] = q.front();
                    q.pop();

                    for (auto &d : dirs)
                    {
                        int dx = x + d[0];
                        int dy = y + d[1];

                        if (dx >= 0 && dx < m && dy >= 0 && dy < n && grid[dx][dy])
                        {
                            rem += grid[dx][dy];

                            q.push({dx, dy});
                            grid[dx][dy] = 0;
                        }
                    }

                    rem = rem % k;
                }

                count += (rem == 0);
            }
        }

        return count;
    }
};
