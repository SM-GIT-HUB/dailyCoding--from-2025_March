#include <bits/stdc++.h>

string fourSum(vector<int> arr, int target, int n) {
    // Write your code here.
    sort(arr.begin(), arr.end());

    for (int i = 0; i < n - 3; i++)
    {
        for (int j = i + 1; j < n - 2; j++)
        {
            int s = j + 1, e = n - 1;
            int sum = arr[i] + arr[j];

            while (s < e)
            {
                int csum = sum + arr[s] + arr[e];

                if (csum == target) {
                    return "Yes";
                }
                else if (csum > target) {
                    e--;
                }
                else
                    s++;
            }
        }
    }

    return "No";
}
