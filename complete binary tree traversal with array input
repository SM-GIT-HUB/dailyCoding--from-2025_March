class Solution {
  public:
    vector<vector<int>> levelSort(vector<int>& arr) {
        // code here
        int idx = 0;
        int n = int(arr.size());
        
        vector<int> temp;
        temp.reserve(n);
        
        vector<vector<int> > ans;
        
        for (int i = 1; idx < n; i = (i << 1))
        {
            temp.clear();
            
            for (int c = 0; idx < n && c < i; c++)
            {
                temp.push_back(arr[idx++]);
            }
            
            sort(temp.begin(), temp.end());
            ans.push_back(temp);
        }
        
        return ans;
    }
};
