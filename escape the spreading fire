
int dist[301][301];
bitset<300> visited[300];
int dirs[4][2] = {{-1, 0}, {0, 1}, {1, 0}, {0, -1}};

class Solution {
public:
    void getDist(int m, int n, vector<vector<int> >& grid)
    {
        queue<pair<int, int> > q;

        for (int i = 0; i < m; i++)
        {
            for (int j = 0; j < n; j++)
            {
                dist[i][j] = -1;

                if (grid[i][j] == 1)
                {
                    dist[i][j] = 0;
                    q.push({i, j});
                }
            }
        }

        while (!q.empty())
        {
            auto [x, y] = q.front();
            q.pop();

            for (auto &d : dirs)
            {
                int dx = x + d[0];
                int dy = y + d[1];

                if (dx >= 0 && dx < m && dy >= 0 && dy < n && grid[dx][dy] == 0 && dist[dx][dy] == -1)
                {
                    dist[dx][dy] = dist[x][y] + 1;
                    q.push({dx, dy});
                }
            }
        }
    }

    int isPos(int mx, int m, int n, vector<vector<int> >& grid)
    {
        for (int i = 0; i < m; i++)
        {
            visited[i].reset();
        }

        queue<pair<int, int> > q;

        q.push({0, 0});
        visited[0][0] = 1;

        while (!q.empty())
        {
            int size = int(q.size());
            ++mx;

            while (size--)
            {
                auto [x, y] = q.front();
                q.pop();

                if (x == m - 1 && y == n - 1) {
                    return 1;
                }

                for (auto &d : dirs)
                {
                    int dx = x + d[0];
                    int dy = y + d[1];

                    if (dx >= 0 && dx < m && dy >= 0 && dy < n && grid[dx][dy] == 0 && !visited[dx][dy])
                    {
                        if (dx == m - 1 && dy == n - 1)
                        {
                            if (mx <= dist[dx][dy] || dist[dx][dy] == -1) {
                                return 1;
                            }
                        }
                        else if (mx < dist[dx][dy] || dist[dx][dy] == -1)
                        {
                            visited[dx][dy] = 1;
                            q.push({dx, dy});
                        }
                    }
                }
            }
        }

        return 0;
    }

    int maximumMinutes(vector<vector<int> >& grid) {
        int m = int(grid.size());
        int n = int(grid[0].size());

        getDist(m, n, grid);

        int ans = -1;
        int start = 0, end = m * n + 2;

        while (start <= end)
        {
            int mid = (start + end) / 2;

            if (isPos(mid, m, n, grid))
            {
                ans = mid;
                start = mid + 1;
            }
            else
                end = mid - 1;
        }

        return (ans > m * n)? 1e9 : ans;
    }
};
