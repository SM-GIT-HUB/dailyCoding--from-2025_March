class Solution {
public:
    int largestInteger(vector<int>& arr, int k) {
        int n = int(arr.size());

        auto isMissing = [&](int num) {
            int cnt = 0;
            int flag = 0;

            for (int i = 0; i < k; i++)
            {
                if (arr[i] == num) {
                    ++cnt;
                }

                if (cnt) {
                    flag = 1;
                }
            }

            if (cnt > 1 && n != k) {
                return 0;
            }

            for (int i = 1; i + k - 1 < n; i++)
            {
                cnt -= (arr[i - 1] == num);
                cnt += (arr[i + k - 1] == num);

                if (flag == 1 && cnt) {
                    return 0;
                }

                if (cnt == 1) {
                    flag = 1;
                }
            }

            return flag;
        };

        for (int num = 50; num >= 0; num--)
        {
            if (isMissing(num)) {
                return num;
            }
        }

        return -1;
    }
};
