class Solution {
  public:
    int maxPackages(vector<int>& arr, int times) {
        // code here
        int sum = 0;
        int ans = 0;
        int n = int(arr.size());
        
        for (int i = 0; i < times && i < n; i++)
        {
            sum += arr[i];
        }
        
        ans = max(sum, ans);
        
        for (int i = 1; i + times - 1 < n; i++)
        {
            sum -= arr[i - 1];
            sum += arr[i + times - 1];
            
            ans = max(sum, ans);
        }
        
        return ans;
    }
};
