#include <bits/stdc++.h>

int LongestSubsetWithZeroSum(vector<int> arr) {
  // Write your code here
  unordered_map<int, int> mapp;

  int len = 0;
  int sum = 0;

  for (int i = 0; i < int(arr.size()); i++)
  {
    sum += arr[i];
    
    if (sum == 0) {
      len = i + 1;
    }
    else
    {
      if (mapp.count(sum)) {
        len = max(i - mapp[sum], len);
      }
      else
        mapp[sum] = i;
    }
  }

  return len;
}
