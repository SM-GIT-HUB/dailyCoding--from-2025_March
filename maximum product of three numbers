class Solution {
public:
    int maximumProduct(vector<int>& arr) {
        int n = int(arr.size());

        int mx1 = INT_MIN, mx2 = INT_MIN, mx3 = INT_MIN;
        int mn1 = INT_MAX, mn2 = INT_MAX, mn3 = INT_MAX;

        for (int x : arr)
        {
            if (x >= mx1)
            {
                mx3 = mx2;
                mx2 = mx1;
                mx1 = x;
            }
            else if (x >= mx2)
            {
                mx3 = mx2;
                mx2 = x;
            }
            else if (x > mx3) {
                mx3 = x;
            }
            
            if (x <= mn1)
            {
                mn3 = mn2;
                mn2 = mn1;
                mn1 = x;
            }
            else if (x <= mn2)
            {
                mn3 = mn2;
                mn2 = x;
            }
            else if (x < mn3) {
                mn3 = x;
            }
        }

        int m1 = mx3 * mx2 * mx1;
        int m2 = mn1 * mn2 * mn3;
        int m3 = mn1 * mn2 * mx1;

        return max({m1, m2, m3});
    }
};
