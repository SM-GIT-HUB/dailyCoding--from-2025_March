bitset<101> mark;

class Solution {
public:
    int sumCounts(vector<int>& nums) {
        int sum = 0;
        int n = int(nums.size());

        for (int i = 0; i < n; i++)
        {
            mark.reset();
            int dist = 0;

            for (int j = i; j < n; j++)
            {
                if (!mark[nums[j]]) {
                    ++dist;
                }

                mark[nums[j]] = 1;

                sum += dist * dist;
            }
        }

        return sum;
    }
};
