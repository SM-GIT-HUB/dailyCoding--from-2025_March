class Solution {
  public:
    int minFlips(string &s) {
        // code here
        int one = 0;
        int two = 0;
        
        for (int i = 0; i < int(s.size()); i++)
        {
            if (i & 1)
            {
                if (s[i] == '0') {
                    one++;
                }
                
                if (s[i] == '1') {
                    two++;
                }
            }
            else
            {
                if (s[i] == '1') {
                    ++one;
                }
                
                if (s[i] == '0') {
                    ++two;
                }
            }
        }
        
        return min(one, two);
    }
};
