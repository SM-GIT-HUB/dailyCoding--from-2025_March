class Solution {
public:
    int maxSubarrayLength(vector<int>& nums, int k) {
        int ans = 0;

        int n = nums.size();
        int start = 0, end = 0;
        
        unordered_map<int, int> mapp;

        while (end < n)
        {
            mapp[nums[end]]++;

            while (mapp[nums[end]] > k)
            {
                mapp[nums[start++]]--;
            }

            ans = max(end - start + 1, ans);
            end++;
        }

        return ans;
    }
};
