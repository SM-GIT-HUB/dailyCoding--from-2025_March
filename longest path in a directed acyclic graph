class Solution {
  public:
    vector<int> maxDistance(int n, int src, vector<vector<int> >& edges) {
        // code here
        vector<int> inn(n);
        vector<vector<pair<int, int> > > adj(n);
        
        for (auto &e : edges)
        {
            inn[e[1]]++;
            adj[e[0]].push_back({e[1], e[2]});
        }
        
        queue<int> q;
        
        for (int u = 0; u < n; u++)
        {
            if (inn[u] == 0) {
                q.push(u);
            }
        }
        
        vector<int> topo;
        
        while (!q.empty())
        {
            int u = q.front();
            q.pop();
            
            topo.push_back(u);
            
            for (auto [v, w] : adj[u])
            {
                if (--inn[v] == 0) {
                    q.push(v);
                }
            }
        }
        
        vector<int> dist(n, INT_MIN);
        
        dist[src] = 0;
        
        for (int u : topo)
        {
            if (dist[u] == INT_MIN) {
                continue;
            }
            
            for (auto [v, w] : adj[u])
            {
                dist[v] = max(dist[v], dist[u] + w);
            }
        }
        
        return dist;
    }
};
