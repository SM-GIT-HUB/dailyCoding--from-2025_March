bitset<101> mark;

class Solution {
public:
    int missingMultiple(vector<int>& arr, int k) {
        mark.reset();

        for (int x : arr)
        {
            mark[x] = 1;
        }

        int m = k;
        int mul = 2;

        while (m < 101 && mark[m])
        {
            m = k * mul++;
        }

        return m;
    }
};
