/* Structure of a Binary Search Tree node
class Node {
  public:
    int data;
    Node* left;
    Node* right;

    Node(int val) {
        data = val;
        left = right = nullptr;
    }
};
*/

class Solution {
  public:
    int minDiff(Node *root, int k) {
        // code here
        int mini = INT_MAX;
        
        while (root)
        {
            mini = min(mini, abs(root->data - k));
            
            if (root->data < k) {
                root = root->right;
            }
            else
                root = root->left;
        }
        
        return mini;
    }
};
