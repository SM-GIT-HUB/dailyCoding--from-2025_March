#include <bits/stdc++.h>

vector<pair<char,int> > duplicate_char(string s, int n) {
    // Write your code here.
    vector<pair<char, int> > arr;

    int mapp1[26] = {0};
    int mapp2[26] = {0};

    for (char ch : s)
    {
        if (ch < 'a') {
            ++mapp2[ch - 'A'];
        }
        else
            ++mapp1[ch - 'a'];
    }

    for (int i = 0; i < 26; i++)
    {
        if (mapp1[i] > 1) {
            arr.push_back({i + 'a', mapp1[i]});
        }

        if (mapp2[i] > 1) {
            arr.push_back({i + 'A', mapp2[i]});
        }
    }

    return arr;
}
