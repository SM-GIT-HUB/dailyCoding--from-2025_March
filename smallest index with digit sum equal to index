class Solution {
public:
    int smallestIndex(vector<int>& nums) {
        auto getSum = [](int x) {
            int sum = 0;

            while (x)
            {
                sum += x % 10;
                x = x / 10;
            }

            return sum;
        };

        for (int i = 0; i < int(nums.size()); i++)
        {
            if (i == getSum(nums[i])) {
                return i;
            }
        }

        return -1;
    }
};
