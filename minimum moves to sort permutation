int mapp[100001];

class Solution {
  public:
    int minMoves(vector<int>& arr) {
        // code here
        int len = 0;
        int n = int(arr.size());
        
        fill(mapp, mapp + n + 1, 0);
        
        for (int x : arr)
        {
            mapp[x] = mapp[x - 1] + 1;
            len = max(len, mapp[x]);
        }
        
        return (n - len);
    }
};
