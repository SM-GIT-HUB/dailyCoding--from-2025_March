class Solution {
public:
    int longestMonotonicSubarray(vector<int>& nums) {
        int maxi = 1;
        int n = int(nums.size());

        for (int i = 0; i < n; i++)
        {
            int d1 = 1;
            int d2 = 1;

            for (int j = i + 1; j < n; j++)
            {
                if (nums[j - 1] >= nums[j]) {
                    d1 = 0;
                }

                if (nums[j - 1] <= nums[j]) {
                    d2 = 0;
                }

                if (d1) {
                    maxi = max(maxi, j - i + 1);
                }
                else if (d2) {
                    maxi = max(maxi, j - i + 1);
                }
                else
                    break;
            }
        }

        return maxi;
    }
};
