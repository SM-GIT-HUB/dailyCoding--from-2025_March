class Solution {
  public:
    vector<int> getMarks(vector<int>& l, vector<int>& r, vector<int>& rank) {
        // code here
        int n = int(l.size());
        int m = int(rank.size());
        
        vector<int> arr;
        
        for (int i = 0; i < n; i++)
        {
            for (int elem = l[i]; elem <= r[i]; elem++)
            {
                arr.push_back(elem);
            }
        }
        
        vector<int> ans;
        
        for (int x : rank)
        {
            ans.push_back(arr[x - 1]);
        }
        
        return ans;
    }
};
