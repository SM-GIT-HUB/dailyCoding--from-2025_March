int dp[100001];

class Solution {
public:
    int tabulation(int n)
    {
        dp[0] = 0;

        for (int m = 1; m <= n; m++)
        {
            int win = 0;

            for (int num = 1; !win && num * num <= m; num++)
            {
                win = !dp[m - num * num];
            }

            dp[m] = win;
        }

        return dp[n];
    }

    bool winnerSquareGame(int n) {
        return tabulation(n);
    }
};
